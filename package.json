{
  "name": "intui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test packages/core packages/claude-code/test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/claude-code && tsc --noEmit -p packages/claude-code/tsconfig.test.json",
    "site": "bun site/build.ts",
    "site:dev": "bun site/build.ts && bunx serve site/dist",
    "plugin": "bun packages/claude-code/build.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
