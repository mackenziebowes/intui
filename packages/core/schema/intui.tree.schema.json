{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "root": {
      "$ref": "#/$defs/Node"
    }
  },
  "required": [
    "v",
    "root"
  ],
  "additionalProperties": false,
  "title": "IntuiTree",
  "$defs": {
    "Node": {
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "$ref": "#/$defs/Group"
        },
        {
          "$ref": "#/$defs/Label"
        },
        {
          "$ref": "#/$defs/Table"
        },
        {
          "$ref": "#/$defs/Chart"
        },
        {
          "$ref": "#/$defs/Stat"
        },
        {
          "$ref": "#/$defs/Flow"
        },
        {
          "$ref": "#/$defs/Marks"
        },
        {
          "$ref": "#/$defs/Ladder"
        },
        {
          "$ref": "#/$defs/Choice"
        },
        {
          "$ref": "#/$defs/Form"
        }
      ]
    },
    "Text": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Text"
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "default": "body",
          "$ref": "#/$defs/Size"
        },
        "tone": {
          "default": "neutral",
          "$ref": "#/$defs/Tone"
        }
      },
      "required": [
        "type",
        "markdown"
      ],
      "additionalProperties": false,
      "x-intui-writer": "anyone"
    },
    "Size": {
      "type": "string",
      "enum": [
        "small",
        "body",
        "heading",
        "title"
      ]
    },
    "Tone": {
      "type": "string",
      "enum": [
        "neutral",
        "positive",
        "warning",
        "critical",
        "muted"
      ]
    },
    "Group": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Group"
        },
        "direction": {
          "default": "column",
          "type": "string",
          "enum": [
            "row",
            "column"
          ]
        },
        "widths": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 4000
              },
              {
                "type": "string",
                "const": "rest"
              }
            ]
          }
        },
        "floors": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4000
          }
        },
        "divider": {
          "default": false,
          "type": "boolean"
        },
        "children": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        }
      },
      "required": [
        "type",
        "children"
      ],
      "additionalProperties": false,
      "x-intui-writer": "anyone"
    },
    "Label": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Label"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "tone": {
          "default": "neutral",
          "$ref": "#/$defs/Tone"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "x-intui-writer": "anyone"
    },
    "Table": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Table"
        },
        "columns": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableColumn"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        "caption": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "x-intui-writer": "anyone"
    },
    "TableColumn": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        }
      },
      "required": [
        "key",
        "label"
      ],
      "additionalProperties": false
    },
    "Chart": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Chart"
        },
        "kind": {
          "type": "string",
          "enum": [
            "line",
            "bar"
          ]
        },
        "title": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "series": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartSeries"
          }
        },
        "annotations": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartAnnotation"
          }
        }
      },
      "required": [
        "type",
        "kind",
        "series"
      ],
      "additionalProperties": false,
      "x-intui-writer": "code"
    },
    "ChartSeries": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "default": "primary",
          "type": "string",
          "enum": [
            "primary",
            "baseline",
            "comparison"
          ]
        },
        "points": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartPoint"
          }
        }
      },
      "required": [
        "label",
        "points"
      ],
      "additionalProperties": false
    },
    "ChartPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": [
            "string",
            "number"
          ]
        },
        "y": {
          "$ref": "#/$defs/Reading"
        },
        "period": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "Reading": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/ReadingObject"
        }
      ],
      "description": "A number, or an object saying how sure it is."
    },
    "ReadingObject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "exact"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "atLeast"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "estimate"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ChartAnnotation": {
      "type": "object",
      "properties": {
        "at": {
          "type": [
            "string",
            "number"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "at",
        "label"
      ],
      "additionalProperties": false
    },
    "Stat": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Stat"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/Reading"
        },
        "unit": {
          "type": "string"
        },
        "change": {
          "$ref": "#/$defs/StatChange"
        },
        "tone": {
          "default": "neutral",
          "$ref": "#/$defs/Tone"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "label",
        "value"
      ],
      "additionalProperties": false,
      "x-intui-writer": "code"
    },
    "StatChange": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/Reading"
        },
        "as": {
          "type": "string",
          "enum": [
            "amount",
            "percent"
          ]
        }
      },
      "required": [
        "value",
        "as"
      ],
      "additionalProperties": false
    },
    "Flow": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Flow"
        },
        "steps": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlowStep"
          }
        },
        "links": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlowLink"
          }
        }
      },
      "required": [
        "type",
        "steps"
      ],
      "additionalProperties": false,
      "x-intui-writer": "anyone"
    },
    "FlowStep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "FlowLink": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "Marks": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Marks"
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarkDeclaredKind"
          }
        },
        "states": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarkDeclaredState"
          }
        },
        "rows": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarksRow"
          }
        }
      },
      "required": [
        "type",
        "kinds",
        "rows"
      ],
      "additionalProperties": false,
      "x-intui-writer": "code"
    },
    "MarkDeclaredKind": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "one": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "MarkDeclaredState": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "default": "neutral",
          "$ref": "#/$defs/Tone"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "MarksRow": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "marks": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mark"
          }
        },
        "halo": {
          "$ref": "#/$defs/MarksHalo"
        },
        "unknown": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "Mark": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "MarksHalo": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "n"
      ],
      "additionalProperties": false
    },
    "Ladder": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Ladder"
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarkDeclaredKind"
          }
        },
        "states": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarkDeclaredState"
          }
        },
        "rungs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/LadderRung"
          }
        },
        "steps": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/LadderStep"
          }
        }
      },
      "required": [
        "type",
        "kinds",
        "rungs"
      ],
      "additionalProperties": false,
      "x-intui-writer": "code"
    },
    "LadderRung": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/LadderNode"
          }
        },
        "empty": {
          "type": "string",
          "minLength": 1
        },
        "unknownKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LadderUnknownKind"
          }
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "LadderNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "full": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "marks": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mark"
          }
        },
        "count": {
          "type": "string",
          "minLength": 1
        },
        "unknown": {
          "type": "string",
          "minLength": 1
        },
        "unknownKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LadderUnknownKind"
          }
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "LadderUnknownKind": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "why"
      ],
      "additionalProperties": false
    },
    "LadderStep": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "from",
        "to",
        "label"
      ],
      "additionalProperties": false
    },
    "Choice": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Choice"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string"
        },
        "options": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChoiceOption"
          }
        },
        "repeat": {
          "default": "once",
          "type": "string",
          "enum": [
            "once",
            "many"
          ]
        }
      },
      "required": [
        "type",
        "id",
        "options"
      ],
      "additionalProperties": false,
      "x-intui-writer": "anyone"
    },
    "ChoiceOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "emphasis": {
          "type": "string",
          "const": "primary"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "Form": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Form"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormField"
          }
        },
        "submitLabel": {
          "default": "Submit",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "type",
        "id",
        "fields"
      ],
      "additionalProperties": false,
      "x-intui-writer": "anyone"
    },
    "FormField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "select",
            "checkbox"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "input"
      ],
      "additionalProperties": false
    }
  }
}
