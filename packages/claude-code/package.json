{
  "name": "@intui/claude-code",
  "version": "0.1.0",
  "description": "A Claude Code plugin that draws IntUI trees in the transcript.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "bun build.ts",
    "conformance": "bun build.ts --out ${INTUI_CONFORMANCE_OUT:-/tmp/intui-conformance} && claude plugin test ${INTUI_CONFORMANCE_OUT:-/tmp/intui-conformance}",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@intui/core": "workspace:*"
  }
}
