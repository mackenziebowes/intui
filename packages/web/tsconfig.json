{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "e2e", "demo", "build.ts"]
}
